    "from rasterio.windows import from_bounds as _fb\n",
    "from scipy.ndimage import distance_transform_edt\n",
    "from mpl_toolkits.mplot3d import Axes3D  # noqa: F401 (registers the 3d projection)\n",
    "\n",
    "def block_mean(a, f):\n",
    "    H = (a.shape[0] // f) * f\n",
    "    W = (a.shape[1] // f) * f\n",
    "    return a[:H, :W].reshape(H//f, f, W//f, f).mean(axis=(1, 3))\n",
    "\n",
    "def clean_patch(wx, wy, path, half=15.0, agg=2):\n",
    "    with rasterio.open(path) as s:\n",
    "        win = _fb(wx-half, wy-half, wx+half, wy+half, s.transform)\n",
    "        a = s.read(1, window=win, boundless=True, fill_value=s.nodata).astype(\"float32\")\n",
    "        nod = s.nodata\n",
    "    valid = np.isfinite(a) & (a != nod)\n",
    "    gap = float(np.nanmean(np.where(valid, a, np.nan) < 2.0))  # fraction of near-ground cells\n",
    "    if (~valid).any() and valid.any():\n",
    "        idx = distance_transform_edt(~valid, return_distances=False, return_indices=True)\n",
